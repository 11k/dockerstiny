FROM node:24.22.0-slim

# Trust Debian's CA store instead of the list compiled into Node, so a CA
# distrust (e.g. the eMudhra intermediates) only needs a rebuild, not a new
# Node release.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_OPTIONS=--use-openssl-ca

WORKDIR /build
COPY --from=certs rootCA.pem dgg.crt
COPY . .
RUN npm ci --production=false

ENV NODE_EXTRA_CA_CERTS=dgg.crt

RUN chown -R node:node /build
USER node

CMD ["npm", "start"]
